{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/docs"
    }
  ],
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/README"
    },
    {
      "source": "/api/:v/qod/:tag",
      "destination": "/api/:v/qod"
    },
    {
      "source": "/api/:path",
      "destination": "/api/:path"
    },
    {
      "source": "/(.*)",
      "destination": "/api/404"
    }
  ],
  "crons": []
}
